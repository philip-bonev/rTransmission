{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rTransmission Client",
  "version": "1.0.8",
  "identifier": "com.bonev.philip.rtransmission-client",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rTransmission Client",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent Torrent File",
        "description": "BitTorrent torrent file",
        "mimeType": "application/x-bittorrent"
      },
      {
        "ext": [
          "magnet"
        ],
        "name": "Magnet Link File",
        "description": "Magnet link file",
        "mimeType": "text/plain"
      }
    ]
  }
}